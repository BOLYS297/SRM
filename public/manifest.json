{
    "$schema": "https://json.schemastore.org/web-manifest-combined.json",
    "name": "Système de Gestion des Requêtes Étudiantes",
    "short_name": "SRM",
    "description": "Plateforme de gestion des requêtes académiques - Soumettez, suivez et obtenez rapidement vos demandes de certificats, duplicatas et corrections",
    "version": "1.0.0",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait-primary",
    "dir": "ltr",
    "lang": "fr-FR",
    "theme_color": "#ef6b3a",
    "background_color": "#ffffff",
    "prefer_related_applications": false,
    "screenshots": [
        {
            "src": "/images/icons/screenshot-540x720.png",
            "sizes": "540x720",
            "type": "image/png",
            "form_factor": "narrow",
            "platform": "android"
        },
        {
            "src": "/images/icons/screenshot-1280x720.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide",
            "platform": "android"
        }
    ],
    "icons": [
        {
            "src": "/images/icons/icon-96x96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/images/icons/icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/images/icons/icon-192x192-maskable.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/images/icons/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/images/icons/icon-512x512-maskable.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "categories": ["education", "productivity"],
    "shortcuts": [
        {
            "name": "Soumettre une requête",
            "short_name": "Soumettre",
            "description": "Créer et soumettre une nouvelle demande académique rapidement",
            "url": "/depot",
            "icons": [
                {
                    "src": "/images/icons/icon-96x96.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Suivi de mes requêtes",
            "short_name": "Suivi",
            "description": "Vérifier l'état et la progression de vos demandes soumises",
            "url": "/suivi",
            "icons": [
                {
                    "src": "/images/icons/icon-96x96.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Historique",
            "short_name": "Historique",
            "description": "Consulter l'historique complet de vos requêtes traitées",
            "url": "/historique",
            "icons": [
                {
                    "src": "/images/icons/icon-96x96.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Mon profil",
            "short_name": "Profil",
            "description": "Gérer vos informations personnelles et vos préférences",
            "url": "/profil",
            "icons": [
                {
                    "src": "/images/icons/icon-96x96.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        }
    ],
    "share_target": {
        "action": "/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "attachment",
                    "accept": [
                        "image/*",
                        "application/pdf",
                        "application/msword",
                        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                    ]
                }
            ]
        }
    },
    "protocol_handlers": [
        {
            "protocol": "web+srm",
            "url": "/request?id=%s"
        }
    ]
}
