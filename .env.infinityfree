# ═══════════════════════════════════════════════════════════════════════════════
# FICHIER .ENV POUR INFINITYFREE
# ═══════════════════════════════════════════════════════════════════════════════
#
# ⚠️  IMPORTANT:
# 1. Renommez ce fichier en ".env" (ajoutez le point au début)
# 2. Remplissez les valeurs SUR INFINITYFREE (pas en local!)
# 3. Chaque modification du .env nécessite un redémarrage/rechargement de page
#
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ───────────────────────────────────────────────────────────────────────────────

# Nom de l'application
APP_NAME=SRM

# Mode d'exécution: local, testing, production
# ✅ CHANGE À PRODUCTION POUR INFINITYFREE
APP_ENV=production

# App Key (IMPORTANT: générez-la avec php artisan key:generate localement)
# ✅ GARDEZ LA MÊME CLÉ, NE LA CHANGEZ PAS APRÈS AVOIR UTILISÉ L'APP
APP_KEY=base64:H9vbmqIyY1YIlrxNoHDrf5BkxsHN3Fe4hmt+zbMNrqA=

# Mode DEBUG: TOUJOURS false en production
# 🔴 DANGER: Ne mettez true que temporairement pour dépanner
APP_DEBUG=false

# URL de l'application: CHANGE AVEC VOTRE DOMAINE INFINITYFREE
# ✅ EXEMPLE: https://monsite.infinityfree.com
APP_URL=https://votre-domaine.infinityfree.com

# ───────────────────────────────────────────────────────────────────────────────
# LOCALE ET TIMEZONE
# ───────────────────────────────────────────────────────────────────────────────

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
TIMEZONE=Europe/Paris

# ───────────────────────────────────────────────────────────────────────────────
# BASE DE DONNÉES MySQL
# ───────────────────────────────────────────────────────────────────────────────

# Type de base de données (MySQL)
DB_CONNECTION=mysql

# Hôte MySQL: GÉNÉRALEMENT "localhost" sur InfinityFree
DB_HOST=localhost

# Port MySQL: généralement 3306
DB_PORT=3306

# Nom de la base de données (créée dans cPanel)
# ✅ À REMPLIR: Exemple: inf_35142756_srm
DB_DATABASE=inf_XXXXXXX_srm

# Utilisateur MySQL
# ✅ À REMPLIR: Exemple: inf_35142756_user
DB_USERNAME=inf_XXXXXXX_user

# Mot de passe MySQL
# ✅ À REMPLIR: Celui défini lors de la création de l'utilisateur
DB_PASSWORD=votre_mot_de_passe_complexe

# ───────────────────────────────────────────────────────────────────────────────
# CACHE ET SESSION
# ───────────────────────────────────────────────────────────────────────────────

# Driver de cache: 'file' est plus compatible que 'database' sur InfinityFree
CACHE_DRIVER=file
CACHE_TTL=seconds

# Driver de sessions: 'file' recommandé pour InfinityFree
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ───────────────────────────────────────────────────────────────────────────────
# QUEUE (Tâches de arrière-plan)
# ───────────────────────────────────────────────────────────────────────────────

QUEUE_CONNECTION=database

# ───────────────────────────────────────────────────────────────────────────────
# MAIL (Courrier électronique)
# ───────────────────────────────────────────────────────────────────────────────

# Driver mail: 'log' enregistre dans les logs, 'smtp' pour envoyer réellement
MAIL_DRIVER=log

# Configuration SMTP (si vous voulez envoyer de vrais emails)
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.mailtrap.io / smtp.gmail.com / etc
# MAIL_PORT=2525 / 587 / etc
# MAIL_USERNAME=votre_email
# MAIL_PASSWORD=votre_mot_de_passe_app
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@votre-site.com
# MAIL_FROM_NAME="SRM - Système de Requêtes"

# ───────────────────────────────────────────────────────────────────────────────
# LOGS
# ───────────────────────────────────────────────────────────────────────────────

# Channel de log: 'stack' = combiner les configurations ci-dessous
LOG_CHANNEL=stack

# Stack de logs
LOG_STACK=single

# Niveau de log: debug, info, notice, warning, error, critical, alert, emergency
# 🔴 PRODUCTION: Utilisez 'warning' ou 'error'
# 🟠 DEBUG: Utilisez 'debug'
LOG_LEVEL=error

# ───────────────────────────────────────────────────────────────────────────────
# REDIS (Optionnel - pas nécessaire pour InfinityFree)
# ───────────────────────────────────────────────────────────────────────────────

# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ───────────────────────────────────────────────────────────────────────────────
# SERVICES EXTERNES (Optionnel)
# ───────────────────────────────────────────────────────────────────────────────

# AWS S3 (pour le stockage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# ───────────────────────────────────────────────────────────────────────────────
# CONFIGURATION SPÉCIFIQUE À L'APPLICATION SRM
# ───────────────────────────────────────────────────────────────────────────────

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Autres configurations si nécessaire
# Ajoutez vos propres variables ici

# ═══════════════════════════════════════════════════════════════════════════════
# 📋 CHECKLIST D'INFINITYFREE
# ═══════════════════════════════════════════════════════════════════════════════
#
# ✅ J'ai changé APP_ENV à "production"
# ✅ J'ai changé APP_DEBUG à "false"
# ✅ J'ai changé APP_URL avec mon domaine InfinityFree
# ✅ J'ai créé une base de données MySQL dans cPanel
# ✅ J'ai rempli DB_DATABASE avec le nom de la base
# ✅ J'ai rempli DB_USERNAME avec l'utilisateur créé
# ✅ J'ai rempli DB_PASSWORD avec le mot de passe
# ✅ J'ai renommé ce fichier en ".env" (ajouter le point)
# ✅ J'ai uploadé ce fichier dans le dossier SRM/
#
# ═══════════════════════════════════════════════════════════════════════════════
